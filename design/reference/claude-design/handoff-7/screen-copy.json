  "brand-components": {
    "visibleStrings": [
      "Handoff 7 · B0 states and drop anatomy",
      "Revision 1.1 unchanged. Earlier sheet retained above; H7 specimens and contracts below supersede only named scopes.",
      "Primary action · busy",
      "353 × 50 minimum. Action/onAction, native indeterminate indicator 16; 8-point gap. Label and height stay fixed.",
      "LIGHT",
      "DARK",
      "Field · plain",
      "54-point minimum; label 13/18 bold, value body. Focus ring 2, gap 2. Error border remains inside focus ring.",
      "LIGHT",
      "DARK",
      "Field · focused",
      "54-point minimum; label 13/18 bold, value body. Focus ring 2, gap 2. Error border remains inside focus ring.",
      "LIGHT",
      "DARK",
      "Field · focused with invalid code",
      "54-point minimum; label 13/18 bold, value body. Focus ring 2, gap 2. Error border remains inside focus ring.",
      "LIGHT",
      "DARK",
      "Failure without a field",
      "Icon 14; gap 8; metadata 13/18 destructive. Body grows; 16 points clear above the primary action.",
      "LIGHT",
      "DARK",
      "Secondary action, Private drafts and text action",
      "Secondary 353 × 50; Private drafts 353 × 76 minimum; text action 44-point minimum target.",
      "LIGHT",
      "DARK",
      "No-club header · largest text",
      "Wordmark 96 wide. At accessibility sizes, wordmark first row; + Add and Account second row. Default header: Add [241,56,80,44]; Account [329,56,44,44].",
      "LIGHT",
      "DARK",
      "Avatar with no readable initial",
      "68, 36, 28, 18 points. Person glyph at 56% of circle; canvas and cover2 shown. Every other cover uses the same avatarOnCover/onAvatarOnCover pair.",
      "LIGHT",
      "DARK",
      "Drop · draft",
      "Thumbnail 76 × 92, radius 14; text begins 12 after photo. Row 17/22; metadata 13/18. US English dates.",
      "LIGHT",
      "DARK",
      "Drop · pending",
      "Thumbnail 76 × 92, radius 14; text begins 12 after photo. Row 17/22; metadata 13/18. US English dates.",
      "LIGHT",
      "DARK",
      "Drop · uploading",
      "Thumbnail 76 × 92, radius 14; text begins 12 after photo. Row 17/22; metadata 13/18. US English dates.",
      "LIGHT",
      "DARK",
      "Drop · processing",
      "Thumbnail 76 × 92, radius 14; text begins 12 after photo. Row 17/22; metadata 13/18. US English dates.",
      "LIGHT",
      "DARK",
      "Drop · failed",
      "Thumbnail 76 × 92, radius 14; text begins 12 after photo. Row 17/22; metadata 13/18. US English dates.",
      "LIGHT",
      "DARK",
      "Drop · collecting, another member",
      "353 wide, 151 minimum, inset 18, radius 16, fold 18; lock 12 + gap 8. No Highlight disclosure to other viewers.",
      "LIGHT",
      "DARK",
      "Drop · collecting, author’s Highlight",
      "star.fill 12, 4 before Highlight; separate line below caption. Sender avatar 28; name gap 12. Status and star scale with text.",
      "LIGHT",
      "DARK",
      "Drop · revealed",
      "Maya’s original chair photograph, 353 × 304; radius 14. Sender avatar 28 + gap 8; row 17/22. Caption gap 8; photo gap 12; label lower left, inset 12.",
      "LIGHT",
      "DARK",
      "Drop · removed placeholder",
      "Only when preserving an open conversation’s place. Surface, radius 12, inset 16. No author, time, caption or reason.",
      "LIGHT",
      "DARK",
      "Drop · draft · largest text",
      "No type cap. Thumbnail remains 76 × 92, aligned to first line when text is taller. Row expands vertically.",
      "LIGHT",
