    "card.status" : {
      "comment" : "handoff 5 copy-contracts, handoff5.card.status: the folded card's status line, {fullDate} then {openTime}; kept over handoff 7's drop.collecting.opening, which splits the date and has no year (D-02, X-10); the middle dot bound to the word before it by a no-break space, so no line starts with it (the check of handoff 7, V-19)",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens %1$@ · %2$@"
