# Cloudflare Pages: headers by path. Pages applies every rule whose path matches a request, in file order.
# Apple fetches the association file with no extension, so its type is set here.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Every page: nothing loads from elsewhere but the invitation page's one request, to the API it names
# (i.html's tadayo-api meta, the same origin as connect-src); no referrer leaves the site (T7, T52).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src https://api-dev.tadayo.app; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
